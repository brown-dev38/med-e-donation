                <mxCell id="export-support-note-3" value="ข้อกำหนด: UNIQUE(batch_id, donation_id) ป้องกันการใส่รายการซ้ำในรอบเดียว แต่ยังอนุญาตให้ donation_id อยู่ในหลายรอบ ON DELETE CASCADE: export_batches → export_items · ON DELETE RESTRICT: donations → export_items / acknowledgement_certificates contact_inquiries.reference_no ไม่มี REFERENCES จึงแสดงเส้นประ; หากต้องการบังคับความสัมพันธ์ ต้องเพิ่ม FK ใน SQL แยกต่างหาก audit_logs.target_table + target_id เป็นอ้างอิงแบบ polymorphic จึงไม่ลากเส้น FK ไปยังทุกตาราง" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=13;fontFamily=Tahoma;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;">
                    <mxGeometry x="60" y="1220" width="2140" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
