                </mxCell>
                <mxCell id="cms-text-1" value="ฟิลด์ทั้งหมดตาม PostgreSQL DDL · created_by และ updated_by เป็นคนละบทบาทและแสดงคนละเส้น" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Tahoma;fontSize=14;fontColor=#475569;">
                    <mxGeometry x="60" y="76" width="1680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="cms-note-2" value="สัญลักษณ์: PK = Primary Key · FK = Foreign Key · UQ = Unique · NN = NOT NULL · NULL = ไม่บังคับ · GEN = คำนวณอัตโนมัติ Crow’s Foot: 1 = หนึ่งรายการ · 0..1 = ศูนย์หรือหนึ่ง · 0..* = ศูนย์หรือหลายรายการ · เส้นประสีม่วง = อ้างอิงเชิงตรรกะ (ไม่มี FK ใน SQL)" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=13;fontFamily=Tahoma;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;">
                    <mxGeometry x="60" y="118" width="1680" height="72" as="geometry"/>
                </mxCell>
