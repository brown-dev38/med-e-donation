                <mxCell id="cms-text-0" value="CMS · ตั้งค่าหน้าแรก · ข่าวประชาสัมพันธ์ · สไลด์แบนเนอร์" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Tahoma;fontSize=28;fontStyle=1;fontColor=#0f172a;">
