generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  ADMIN
  FINANCE_OFFICER
  VIEWER
}

enum DonorType {
  INDIVIDUAL
  CORPORATE
}

enum VerificationStatus {
  PENDING_SLIP_CHECK
  WAITING_TREASURY_RD
  COMPLETED_RD
  REJECTED
}

enum ExportStatus {
  PENDING
  EXPORTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ScholarshipFund {
  fundId              Int      @id @default(autoincrement()) @map("fund_id")
  fundCode            String   @unique @map("fund_code") @db.VarChar(50)
  fundNameTh          String   @map("fund_name_th") @db.VarChar(255)
  fundDescription     String?  @map("fund_description") @db.Text
  requiresStudentName Boolean  @default(false) @map("requires_student_name")
  bankName            String   @default("ธนาคารกรุงไทย") @map("bank_name") @db.VarChar(100)
  bankAccountNo       String   @map("bank_account_no") @db.VarChar(50)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  donations           Donation[]

  @@map("scholarship_funds")
}

model AdminUser {
  userId              Int       @id @default(autoincrement()) @map("user_id")
  username            String    @unique @db.VarChar(100)
  fullName            String    @map("full_name") @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  role                AdminRole
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.DateTime(3)
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  sessions            AdminSession[]
  slipVerified        Donation[] @relation("SlipVerifier")
  rdSubmitted         Donation[] @relation("RdSubmitter")
  certificates        AcknowledgementCertificate[]
  exportBatches       EdonationExportBatch[]
  inquiries           ContactInquiry[]
  auditLogs           AuditLog[]
  landingConfigs      LandingPageConfig[]
  articlesCreated     PrNewsArticle[] @relation("ArticleCreator")
  articlesUpdated     PrNewsArticle[] @relation("ArticleUpdater")
  carouselSlides      LandingCarouselSlide[]
  notificationsRead   AdminNotification[]

  @@map("admin_users")
}

model AdminSession {
  sessionId String    @id @default(uuid()) @map("session_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      AdminUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Donation {
  donationId             String             @id @default(uuid()) @map("donation_id") @db.Char(36)
  referenceNo            String             @unique @map("reference_no") @db.VarChar(30)
  fundId                 Int                @map("fund_id")
  studentRecipientName   String?            @map("student_recipient_name") @db.VarChar(255)
  studentRecipientCode   String?            @map("student_recipient_code") @db.VarChar(20)
  donorType              DonorType          @map("donor_type")
  donorPrefix            String             @map("donor_prefix") @db.VarChar(50)
  donorName              String             @map("donor_name") @db.VarChar(255)
  taxIdEncrypted         String             @map("tax_id_encrypted") @db.Text
  taxIdMasked            String             @map("tax_id_masked") @db.VarChar(20)
  taxIdHash              String             @map("tax_id_hash") @db.Char(64)
  phone                  String             @db.VarChar(30)
  email                  String             @db.VarChar(255)
  needTaxDeduction       Boolean            @default(true) @map("need_tax_deduction")
  pdpaConsent            Boolean            @default(true) @map("pdpa_consent")
  amount                 Decimal            @db.Decimal(12, 2)
  transferDate           DateTime           @map("transfer_date") @db.Date
  transferTime           DateTime           @map("transfer_time") @db.Time(0)
  slipFilePath           String             @map("slip_file_path") @db.VarChar(500)
  slipFileHash           String?            @map("slip_file_hash") @db.Char(64)
  verificationStatus     VerificationStatus @default(PENDING_SLIP_CHECK) @map("verification_status")
  slipVerifiedBy         Int?               @map("slip_verified_by")
  slipVerifiedAt         DateTime?          @map("slip_verified_at") @db.DateTime(3)
  rdSubmittedBy          Int?               @map("rd_submitted_by")
  rdSubmittedAt          DateTime?          @map("rd_submitted_at") @db.DateTime(3)
  rdConfirmEmailSentAt   DateTime?          @map("rd_confirm_email_sent_at") @db.DateTime(3)
  rejectionReason        String?            @map("rejection_reason") @db.Text
  // STORED generated column, defined explicitly in the initial SQL migration.
  edonationSlaDueDate     DateTime?          @default(dbgenerated()) @map("edonation_sla_due_date") @db.Date
  edonationExportStatus   ExportStatus       @default(PENDING) @map("edonation_export_status")
  createdAt              DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  fund                   ScholarshipFund    @relation(fields: [fundId], references: [fundId], onDelete: Restrict, onUpdate: Restrict)
  slipVerifier           AdminUser?         @relation("SlipVerifier", fields: [slipVerifiedBy], references: [userId], onDelete: SetNull)
  rdSubmitter            AdminUser?         @relation("RdSubmitter", fields: [rdSubmittedBy], references: [userId], onDelete: SetNull)
  certificate            AcknowledgementCertificate?
  exportItems            EdonationExportItem[]
  notifications          AdminNotification[]

  @@index([verificationStatus], map: "idx_donations_verification_status")
  @@index([transferDate], map: "idx_donations_transfer_date")
  @@index([taxIdHash], map: "idx_donations_tax_id_hash")
  @@index([slipFileHash], map: "idx_donations_slip_file_hash")
  @@index([edonationExportStatus, verificationStatus], map: "idx_donations_edonation_export")
  @@map("donations")
}

model AcknowledgementCertificate {
  certificateId   String      @id @default(uuid()) @map("certificate_id") @db.Char(36)
  donationId      String      @unique @map("donation_id") @db.Char(36)
  fiscalYearBe    Int         @map("fiscal_year_be") @db.SmallInt
  runningSeq      Int         @map("running_seq")
  documentNo      String      @unique @map("document_no") @db.VarChar(30)
  pdfFilePath     String?     @map("pdf_file_path") @db.VarChar(500)
  emailSentStatus EmailStatus @default(PENDING) @map("email_sent_status")
  emailSentAt     DateTime?   @map("email_sent_at") @db.DateTime(3)
  issuedBy        Int         @map("issued_by")
  issuedAt        DateTime    @default(now()) @map("issued_at") @db.DateTime(3)
  donation        Donation    @relation(fields: [donationId], references: [donationId], onDelete: Restrict)
  issuer          AdminUser   @relation(fields: [issuedBy], references: [userId], onDelete: Restrict)

  @@unique([fiscalYearBe, runningSeq])
  @@map("acknowledgement_certificates")
}

model EdonationExportBatch {
  batchId      Int       @id @default(autoincrement()) @map("batch_id")
  batchNo      String    @unique @map("batch_no") @db.VarChar(30)
  dateFrom     DateTime  @map("date_from") @db.Date
  dateTo       DateTime  @map("date_to") @db.Date
  totalRecords Int       @default(0) @map("total_records")
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  exportedBy   Int       @map("exported_by")
  exportedAt   DateTime  @default(now()) @map("exported_at") @db.DateTime(3)
  remarks      String?   @db.Text
  exporter     AdminUser @relation(fields: [exportedBy], references: [userId], onDelete: Restrict)
  items        EdonationExportItem[]

  @@map("edonation_export_batches")
}

model EdonationExportItem {
  itemId     BigInt               @id @default(autoincrement()) @map("item_id")
  batchId    Int                  @map("batch_id")
  donationId String               @map("donation_id") @db.Char(36)
  batch      EdonationExportBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  donation   Donation             @relation(fields: [donationId], references: [donationId], onDelete: Restrict)

  @@unique([batchId, donationId])
  @@map("edonation_export_items")
}

model ContactInquiry {
  inquiryId    BigInt        @id @default(autoincrement()) @map("inquiry_id")
  referenceNo  String?       @map("reference_no") @db.VarChar(30)
  inquirerName String        @map("inquirer_name") @db.VarChar(255)
  contactInfo  String        @map("contact_info") @db.VarChar(255)
  inquiryType  String        @default("FOLLOW_UP_EDONATION") @map("inquiry_type") @db.VarChar(50)
  message      String        @db.Text
  status       InquiryStatus @default(OPEN)
  resolvedBy   Int?          @map("resolved_by")
  resolvedNote String?       @map("resolved_note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  resolvedAt   DateTime?     @map("resolved_at") @db.DateTime(3)
  resolver     AdminUser?    @relation(fields: [resolvedBy], references: [userId], onDelete: SetNull)

  @@map("contact_inquiries")
}

model AuditLog {
  logId       BigInt     @id @default(autoincrement()) @map("log_id")
  userId      Int?       @map("user_id")
  action      String     @db.VarChar(50)
  targetTable String     @map("target_table") @db.VarChar(50)
  targetId    String     @map("target_id") @db.VarChar(64)
  details     Json?
  ipAddress   String?    @map("ip_address") @db.VarChar(45)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  user        AdminUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@map("audit_logs")
}

model LandingPageConfig {
  configId            Int        @id @default(autoincrement()) @map("config_id")
  // SQL owns this Unicode default; MySQL metadata cannot round-trip its emoji reliably.
  heroBadgeText       String     @default(dbgenerated()) @map("hero_badge_text") @db.VarChar(255)
  heroTitleLine1      String     @default("ให้โอกาสทางการศึกษา") @map("hero_title_line1") @db.VarChar(255)
  heroTitleLine2      String     @default("สร้างอนาคตทางการแพทย์") @map("hero_title_line2") @db.VarChar(255)
  heroDescription     String     @map("hero_description") @db.Text
  heroImagePath       String     @map("hero_image_path") @db.VarChar(500)
  heroImageCaption    String?    @map("hero_image_caption") @db.VarChar(255)
  topAnnouncementText String     @map("top_announcement_text") @db.Text
  showTotalRaised     Boolean    @default(true) @map("show_total_raised")
  updatedBy           Int?       @map("updated_by")
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updater             AdminUser? @relation(fields: [updatedBy], references: [userId], onDelete: SetNull)

  @@map("landing_page_configs")
}

model PrNewsArticle {
  articleId      Int        @id @default(autoincrement()) @map("article_id")
  title          String     @db.VarChar(255)
  category       String     @default("ข่าวประชาสัมพันธ์") @db.VarChar(100)
  summary        String     @db.Text
  contentHtml    String?    @map("content_html") @db.Text
  coverImagePath String?    @map("cover_image_path") @db.VarChar(500)
  publishedDate  DateTime   @default(dbgenerated("(curdate())")) @map("published_date") @db.Date
  isPublished    Boolean    @default(true) @map("is_published")
  isPinned       Boolean    @default(false) @map("is_pinned")
  createdBy      Int?       @map("created_by")
  updatedBy      Int?       @map("updated_by")
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  creator        AdminUser? @relation("ArticleCreator", fields: [createdBy], references: [userId], onDelete: SetNull)
  updater        AdminUser? @relation("ArticleUpdater", fields: [updatedBy], references: [userId], onDelete: SetNull)

  @@index([isPublished, isPinned(sort: Desc), publishedDate(sort: Desc)], map: "idx_pr_news_published")
  @@map("pr_news_articles")
}

model LandingCarouselSlide {
  slideId       Int        @id @default(autoincrement()) @map("slide_id")
  displayOrder  Int        @default(1) @map("display_order")
  badgeTag      String     @map("badge_tag") @db.VarChar(150)
  slideSubtitle String     @map("slide_subtitle") @db.VarChar(255)
  slideCaption  String     @map("slide_caption") @db.Text
  imagePath     String     @map("image_path") @db.VarChar(500)
  ctaUrl        String?    @map("cta_url") @db.VarChar(500)
  isActive      Boolean    @default(true) @map("is_active")
  updatedBy     Int?       @map("updated_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updater       AdminUser? @relation(fields: [updatedBy], references: [userId], onDelete: SetNull)

  @@index([isActive, displayOrder], map: "idx_carousel_active_order")
  @@map("landing_carousel_slides")
}

model AdminNotification {
  notificationId BigInt     @id @default(autoincrement()) @map("notification_id")
  donationId     String     @map("donation_id") @db.Char(36)
  notifyType     String     @default("NEW_SLIP_UPLOADED") @map("notify_type") @db.VarChar(50)
  title          String     @db.VarChar(255)
  channelSent    String     @default("WEB,EMAIL") @map("channel_sent") @db.VarChar(50)
  isRead         Boolean    @default(false) @map("is_read")
  readBy         Int?       @map("read_by")
  readAt         DateTime?  @map("read_at") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  donation       Donation   @relation(fields: [donationId], references: [donationId], onDelete: Cascade)
  reader         AdminUser? @relation(fields: [readBy], references: [userId], onDelete: SetNull)

  @@index([isRead, createdAt(sort: Desc)], map: "idx_admin_notifications_unread")
  @@map("admin_notifications")
}
