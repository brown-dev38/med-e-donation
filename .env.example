DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/med-e-donation"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD=""
# Optional display name, defaults to BOOTSTRAP_ADMIN_USERNAME.
BOOTSTRAP_ADMIN_NAME=""
# AES-256 key for donor tax IDs (32 bytes, base64). Generate once and never change it after
# donations exist, or stored tax IDs can no longer be decrypted:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TAX_ID_ENCRYPTION_KEY=""
# Private folder for uploaded transfer slips (outside public/). Defaults to ./storage
SLIP_STORAGE_DIR=""
# Email to donors. Without SMTP_HOST, development writes messages to storage/outbox/*.eml
# and production marks the email as failed so staff can resend after fixing the settings.
SMTP_HOST=""
SMTP_PORT="587"
# "true" for port 465 (implicit TLS); otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MED UP e-Donation <medfund@up.ac.th>"
